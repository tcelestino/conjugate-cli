{
  "name": "@tcelestino/conjugate-cli",
  "version": "1.1.3",
  "description": "Command line that find to conjugate a verb",
  "main": "conjugate.js",
  "scripts": {
    "lint": "eslint *.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tcelestino/conjugate-cli.git"
  },
  "keywords": [
    "english",
    "learn",
    "scraper"
  ],
  "preferGlobal": true,
  "bin": {
    "conjugate": "./conjugate.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0"
  },
  "bugs": {
    "url": "https://github.com/tcelestino/conjugate-cli/issues"
  },
  "homepage": "https://github.com/tcelestino/conjugat-cli#readme",
  "author": "Tiago Celestino",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.7",
    "@vitest/ui": "^4.0.7",
    "eslint": "^9.16.0",
    "vitest": "^4.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
